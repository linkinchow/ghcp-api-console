# Copy this file to .env before running docker compose.
# Replace every change-me value before deploying outside local development.

LOG_LEVEL=info

# Build-time only: use your organization's approved npm registry when required.
# Do not include credentials in this URL; use a build secret for authenticated feeds.
NPM_REGISTRY=https://registry.npmjs.org/

# Shared internal/API secrets.
API_KEY=change-me-proxy-api-key
INTERNAL_API_TOKEN=change-me-internal-token
SESSION_SECRET=change-me-session-secret

# Host ports exposed by docker compose.
PROXY_PORT=3000
SSO_PORT=7001
LOGIN_PORT=7003
CONSOLE_PORT=7004

# Proxy public API and OpenCode-compatible Copilot authentication.
STORAGE_DRIVER=sqlite
DB_PATH=/data/proxy.sqlite
# Required when STORAGE_DRIVER=mysql. Use a shared external MySQL 8 database in production.
MYSQL_URL=
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL_MODE=disabled
MYSQL_SSL_CA_PATH=
IDENTITY_INIT_LEASE_SECONDS=900
IDENTITY_HEADER=X-User-Identity
IDENTITY_HEADER_REQUIRED=true

# Opt-in exclusive user pool; direct mode ignores pool-only settings.
# See docs/user-pool-implementation.md BEFORE enabling (paid seats and admin permissions).
ACCOUNT_ROUTING_MODE=direct
POOL_ACCOUNT_EMAIL_DOMAIN=
POOL_WARMUP_MODEL=
READY_IDLE_TARGET=10
POOL_MAX_ACCOUNTS=100
CALLER_LEASE_TTL_SECONDS=172800
PROVISIONAL_LEASE_TTL_SECONDS=300
PREWARM_POLL_SECONDS=5
# Concurrent account stages; Login browser concurrency is configured separately.
PREWARM_CONCURRENCY=5
# Outstanding pool Login dispatch/wait reservations; not browser concurrency.
POOL_LOGIN_MAX_PENDING=5
POOL_EXHAUSTED_RETRY_AFTER_SECONDS=30
POOL_REQUEST_TIMEOUT_SECONDS=120
# Caller identity is an authenticated virtual-key hash, NOT email; no caller domain.
# LiteLLM hook environment (set on your gateway, not Proxy). Exact selected api_base.
GHCP_POOL_API_BASE=http://proxy:3000
GHCP_POOL_API_BASES=http://proxy:3000

# Default Claude Code mode; requests can override with X-Claude-Code-Optimized.
CLAUDE_CODE_OPTIMIZED=true
REQUEST_STATS_PER_ACCOUNT_LIMIT=2
PROXY_ERROR_DIAGNOSTICS_ENABLED=true
PROXY_ERROR_DIAGNOSTICS_DIR=/data/error-diagnostics
PROXY_ERROR_DIAGNOSTICS_REDACT=false
PROXY_ERROR_DIAGNOSTICS_MAX_FILE_MB=50
PROXY_ERROR_DIAGNOSTICS_MAX_FILES=5
# For multiple Proxy Pods, mount one RWX volume at PROXY_ERROR_DIAGNOSTICS_DIR.
PROXY_ERROR_DIAGNOSTICS_SHARED=false
PROXY_INSTANCE_ID=

GITHUB_OAUTH_CLIENT_ID=Ov23li8tweQw6odWQebz
GITHUB_OAUTH_SCOPE=read:user
COPILOT_API_BASE_URL=https://api.githubcopilot.com
OPENCODE_VERSION=1.18.4
GITHUB_API_VERSION=2026-06-01

# SSO/SAML settings. This base URL must match the IdP URLs configured in GitHub.
SSO_PUBLIC_BASE_URL=http://sso:7001
SSO_CERT_DIR=./certs
SP_ENTITY_ID=https://github.com/enterprises/acme
SP_ACS_URL=https://github.com/enterprises/acme/saml/consume
# Pool mode requires a strong value of at least 16 characters; do not use a username.
# Existing direct users keep their stored password hashes.
SSO_DEFAULT_USER_PASSWORD=

# GitHub Enterprise / SCIM / Copilot settings.
ENTERPRISE_SLUG=acme
ENTERPRISE_SHORTCODE=octo
GITHUB_API_BASE_URL=https://api.github.com
SCIM_BASE_URL=https://api.github.com/scim/v2/enterprises/acme
SCIM_TOKEN=change-me-scim-token
GITHUB_COPILOT_SEAT_PAT=change-me-github-pat

# Login worker settings.
# In Compose, use the SSO service name; 127.0.0.1 would point to the login container itself.
LOGIN_SSO_URL=http://sso:7001/login
LOGIN_SSO_PROVIDER=custom
AUTH_HEADLESS=true
