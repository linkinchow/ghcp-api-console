worker_processes auto;
pid /tmp/nginx.pid;
error_log stderr warn;
worker_shutdown_timeout 300s;

events {
    worker_connections 512;
}

http {
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    map $http_x_user_identity $ghcp_pool {
        default "";
        "~^sha256:[0-3][0-9a-f]{63}$" ghcp_pool_1;
        "~^sha256:[4-6][0-9a-f]{63}$" ghcp_pool_2;
        "~^sha256:[7-9][0-9a-f]{63}$" ghcp_pool_3;
        "~^sha256:[a-c][0-9a-f]{63}$" ghcp_pool_4;
        "~^sha256:[d-f][0-9a-f]{63}$" ghcp_pool_5;
    }

    map "$request_method:$uri" $ghcp_route_allowed {
        default 0;
        "~^(GET|HEAD):/v1/models$" 1;
        "~^POST:/(chat/completions|responses|v1/messages|v1/messages/count_tokens)$" 1;
    }

    upstream ghcp_pool_1 { server REPLACE_BACKEND_1; keepalive 32; }
    upstream ghcp_pool_2 { server REPLACE_BACKEND_2; keepalive 32; }
    upstream ghcp_pool_3 { server REPLACE_BACKEND_3; keepalive 32; }
    upstream ghcp_pool_4 { server REPLACE_BACKEND_4; keepalive 32; }
    upstream ghcp_pool_5 { server REPLACE_BACKEND_5; keepalive 32; }

    server {
        listen 8080;
        client_max_body_size 16m;
        client_body_timeout 60s;
        keepalive_timeout 65s;
        gzip off;

        location = /healthz {
            default_type application/json;
            return 200 '{"status":"ok","scope":"router_process"}';
        }

        location / {
            default_type application/json;
            if ($ghcp_route_allowed = 0) {
                return 404 '{"error":{"code":"route_not_supported"}}';
            }
            if ($ghcp_pool = "") {
                return 400 '{"error":{"code":"invalid_caller_identity"}}';
            }

            REPLACE_TRUSTED_ALLOW_RULES
            deny all;

            proxy_pass http://$ghcp_pool;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $proxy_host;
            proxy_set_header X-User-Identity $http_x_user_identity;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header X-API-Key $http_x_api_key;
            proxy_set_header X-Internal-Token "";
            proxy_set_header X-Forwarded-For $remote_addr;

            proxy_next_upstream off;
            proxy_intercept_errors off;
            proxy_buffering off;
            proxy_request_buffering on;
            proxy_cache off;
            proxy_ignore_client_abort off;
            proxy_connect_timeout 5s;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            send_timeout 300s;
        }
    }
}
